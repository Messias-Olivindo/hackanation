# =============================================================================
# .gitignore — Arquivos e pastas ignorados no versionamento do Git
# =============================================================================

# Node & Frontend
node_modules/
/app/node_modules/
/programs/seller-dao/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.eslintcache

# Next.js
.next/
/app/.next/
out/
build/

# Rust & Cargo
target/
/programs/seller-dao/target/
**/*.rs.bk
Cargo.lock

# Anchor & Solana
.anchor/
/programs/seller-dao/.anchor/
test-ledger/
/test-ledger/
.solana/

# Solana Keypairs (Garante segurança contra commits acidentais de chaves privadas)
**/*-keypair.json
**/keypair.json
**/*.key
**/*.pem

# Environment Variables (Segredos e chaves de API locais)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.wallet
.env*.local

# IDEs & Editores de Código
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.project
.classpath
.settings/

# OS / Arquivos do Sistema
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs & Cobertura de Testes
logs/
*.log
coverage/
.nyc_output/

# AI Private Docs (Notas privadas do desenvolvedor no hub de IA)
ai/private/
